# Copie para .env.local (na sua maquina) ou cole no painel da hospedagem.

# Assina o cookie de login. OBRIGATORIA em producao, minimo 16 caracteres.
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Banco de dados Postgres. Sem esta variavel, o sistema sobe um Postgres
# dentro do proprio processo (pasta .pglite), que serve para testar na sua
# maquina mas NAO serve para uso de verdade.
# Exemplo (Neon): postgres://usuario:senha@ep-xxx.neon.tech/calhas?sslmode=require
DATABASE_URL=
